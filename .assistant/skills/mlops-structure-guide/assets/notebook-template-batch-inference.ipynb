 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Batch Inference Notebook\n",
    "\n",
    "This notebook loads the `@champion` model and scores new data in batch.\n",
    "\n",
    "**TODO:** Adapt this notebook to your inference data source and prediction schema."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install dependencies\n",
    "%pip install -r ../../requirements.txt\n",
    "dbutils.library.restartPython()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define widgets for parameterization\n",
    "dbutils.widgets.text(\"catalog_name\", \"mlops_quickstart_dev\")\n",
    "dbutils.widgets.text(\"schema_name\", \"iris\")\n",
    "dbutils.widgets.text(\"model_version\", \"1\")  # Optional: can specify model version explicitly\n",
    "\n",
    "catalog_name = dbutils.widgets.get(\"catalog_name\")\n",
    "schema_name = dbutils.widgets.get(\"schema_name\")\n",
    "model_version = dbutils.widgets.get(\"model_version\")\n",
    "\n",
    "print(f\"Catalog: {catalog_name}\")\n",
    "print(f\"Schema: {schema_name}\")\n",
    "print(f\"Model version: {model_version}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Load champion model\n",
    "\n",
    "Always load the `@champion` alias (never hardcode a version)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import mlflow\n",
    "import pandas as pd\n",
    "from datetime import datetime\n",
    "\n",
    "# TODO: Change \"iris_model\" to your model name\n",
    "model_name = f\"{catalog_name}.{schema_name}.iris_model\"\n",
n",
    "# Load @champion model\n",
    "champion_uri = f\"models:/{model_name}@champion\"\n",
    "\n",
    "try:\n",
    "    champion_model = mlflow.pyfunc.load_model(champion_uri)\n",
    "    print(f\"✓ Loaded @champion model: {champion_uri}\")\n",
    "except Exception as e:\n",
    "    print(f\"❌ Failed to load @champion model: {e}\")\n",
    "    raise Exception(\n",
    "        f\"Cannot find @champion alias for {model_name}. \"\n",
    "        \"Please run the deployment pipeline first.\"\n",
    "    )"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Load inference data\n",
    "\n",
    "**TODO:** Replace this with your inference data source.\n",
    "Examples:\n",
    "- Existing Delta table: `spark.read.table(...)`\n",
    "- Cloud storage: `spark.read.format(\"parquet\").load(...)`\n",
    "- SQL query: `spark.sql(...)`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Example: Load new iris samples from a table\n",
    "# TODO: Change \"new_iris_samples\" to your inference data table\n",
    "inference_table = f\"{catalog_name}.{schema_name}.new_iris_samples\"\n",
    "\n",
    "try:\n",
    "    df_inference = spark.read.table(inference_table).toPandas()\n",
    "    print(f\"✓ Loaded {len(df_inference)} rows from {inference_table}\")\n",
    "except Exception as e:\n",
    "    print(f\"❌ Could not load inference table: {e}\")\n",
    "    print(f\"\\nCreating sample data for demonstration...\")\n",
    "    \n",
    "    # Create sample data if table doesn't exist\n",
    "    import numpy as np\n",
    "    np.random.seed(42)\n",
    "    sample_data = np.random.randn(10, 4) * 0.5 + 5.5  # Similar to Iris data\n",
    "    df_inference = pd.DataFrame(\n",
    "        sample_data,\n",
    "        columns=['sepal_length', 'sepal_width', 'petal_length', 'petal_width']\n",
    "    )\n",
    "    print(f\"✓ Created {len(df_inference)} sample rows for demonstration\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Prepare features\n",
    "\n",
    "Select and order features to match training data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# TODO: Change feature column order to match training\n",
    "feature_cols = ['sepal_length', 'sepal_width', 'petal_length', 'petal_width']\n",
    "\n",
    "# Verify all features are present\n",
    "missing_cols = [col for col in feature_cols if col not in df_inference.columns]\n",
    "if missing_cols:\n",
    "    raise ValueError(f\"Missing required columns: {missing_cols}\")\n",
    "\n",
    "X_inference = df_inference[feature_cols]\n",
    "print(f\"✓ Selected {len(feature_cols)} features\")\n",
    "print(f\"  Features: {feature_cols}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Score data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Make predictions\n",
    "predictions = champion_model.predict(X_inference)\n",
    "\n",
    "print(f\"✓ Scored {len(predictions)} rows\")\n",
    "print(f\"\\nPrediction distribution:\")\n",
    "import numpy as np\n",
    "unique, counts = np.unique(predictions, return_counts=True)\n",
    "for pred_class, count in zip(unique, counts):\n",
    "    print(f\"  Class {pred_class}: {count} samples\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Add predictions to results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Add predictions to original data\n",
    "df_results = df_inference.copy()\n",
    "df_results['prediction'] = predictions\n",
    "df_results['prediction_timestamp'] = datetime.now()\n",
    "\n",
    "# Add metadata\n",
    "df_results['model_name'] = model_name\n",
    "df_results['model_alias'] = 'champion'\n",
    "\n",
    "print(f\"\\nSample predictions (first 5 rows):\")\n",
    "print(df_results[['sepal_length', 'sepal_width', 'prediction', 'prediction_timestamp']].head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 6: Write predictions\n",
    "\n",
    "Write results to an inference table for analysis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert to Spark DataFrame\n",
    "df_results_spark = spark.createDataFrame(df_results)\n",
    "\n",
    "# TODO: Change \"iris_predictions\" to your predictions table name\n",
    "predictions_table = f\"{catalog_name}.{schema_name}.iris_predictions\"\n",
    "\n",
    "# Write predictions (idempotent: overwrite if exists)\n",
    "df_results_spark.write.mode(\"overwrite\").format(\"delta\").saveAsTable(predictions_table)\n",
    "\n",
    "print(f\"✓ Wrote {len(df_results)} predictions to {predictions_table}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Verification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Verify predictions table\n",
    "df_verify = spark.read.table(predictions_table)\n",
    "\n",
    "print(f\"✓ Verified: {df_verify.count()} rows in {predictions_table}\")\n",
    "print(f\"\\nSchema:\")\n",
    "df_verify.printSchema()\n",
    "print(f\"\\nSample data:\")\n",
    "df_verify.limit(5).display()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=\"*60)\n",
    "print(\"✓ BATCH INFERENCE COMPLETE\")\n",
    "print(\"=\"*60)\n",
    "print(f\"\\nModel: {model_name}\")\n",
    "print(f\"Model Alias: @champion\")\n",
    "print(f\"Rows scored: {len(df_results)}\")\n",
    "print(f\"Results table: {predictions_table}\")\n",
    "print(\"=\"*60)"
   ]
  }
 ],
